import funkin.modding.module.ScriptedModule;

class Testing extends ScriptedModule {
    var configManager:JsonConfig;

    var defaultConfig:Dynamic = {
        test: ["test", true],
        enabled: true,
        speed: 10.5
    };

    function new() {
        super("Testing");
        configManager = new JsonConfig("testing1", defaultConfig);
    }
}